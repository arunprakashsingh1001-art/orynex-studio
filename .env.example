# ==============================================================================
# Orynex Studio — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Vite)
# Store these in .env or .env.local
# Note: Vite only exposes variables prefixed with VITE_ to the browser bundle.
# NEVER place secret keys (such as service_role or API private keys) here.
# ------------------------------------------------------------------------------

# Option 1: Direct Edge Function URL
VITE_SUPABASE_FUNCTIONS_URL=https://your-project-id.supabase.co/functions/v1/submit-lead

# Option 2: Standard Supabase Project URL (fallback)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# Supabase Edge Function Secrets (Server-Side ONLY)
# Configure these in your Supabase project using Supabase CLI:
#   supabase secrets set RESEND_API_KEY=re_... ADMIN_NOTIFICATION_EMAIL=admin@orynex.studio
# Or via Supabase Dashboard: Project Settings > Edge Functions > Secrets
# ------------------------------------------------------------------------------

# Resend API Key for transactional notification emails (optional for DB save)
RESEND_API_KEY=re_your_api_key_here

# Recipient email address for new lead notifications
ADMIN_NOTIFICATION_EMAIL=leads@orynex.studio

# Sender identity (must match a verified domain or onboarding@resend.dev during testing)
SENDER_EMAIL=Orynex Studio <onboarding@resend.dev>

# Optional salt for client IP hashing
IP_SALT=your_random_salt_here
